MONGODB_URI=mongodb://localhost:27018/emailservice
REDIS_URL=redis://localhost:6380
JWT_SECRET=change_this_to_a_long_random_string
# Google Cloud OAuth client (Gmail API) — lets each user send tracked email
# through their own Gmail account so it's genuinely from gmail.com (passes
# DKIM/SPF/DMARC) instead of relaying through a third-party ESP, which
# Gmail's DMARC policy rejects for a gmail.com From address.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Must be a publicly reachable HTTPS origin (e.g. an ngrok tunnel in dev, or
# your deployed domain) — Gmail/Outlook/etc fetch the tracking pixel from here.
BASE_URL=https://your-ngrok-url.ngrok-free.app
PORT=5000
# Must also be a publicly reachable HTTPS origin — used to build PDF share
# links attached to outgoing emails, so they resolve for external recipients.
CLIENT_URL=https://your-ngrok-url.ngrok-free.app

# --- AI layer (doc/02-ai-architecture.md) ---
# Master switch. Everything under src/ai/ refuses to run unless this is "true".
AI_ENABLED=false
# Anthropic API key used by the single client in src/ai/client.ts.
ANTHROPIC_API_KEY=sk-ant-...
# Per-user daily token ceilings, enforced before each call (ADR-14).
# The default applies to any run kind without its own value; 0 refuses that kind.
AI_DAILY_TOKENS_DEFAULT=200000
AI_DAILY_TOKENS_EXTRACT_MEMORY=300000
AI_DAILY_TOKENS_DRAFT_FOLLOW_UP=150000
AI_DAILY_TOKENS_INVESTIGATE=200000
# Earned autonomy for reversible proposal kinds (ADR-16). Off until Phase 4.
AI_TRUST_POLICY_ENABLED=false
AI_TRUST_MIN_SAMPLE=50
AI_TRUST_MIN_ACCEPTANCE=0.95
AI_TRUST_MIN_CONFIDENCE=0.8
